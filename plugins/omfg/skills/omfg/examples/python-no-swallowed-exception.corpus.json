      "source": "tool",
      "tool": "edit",
      "path": "svc/index.py",
      "text": "    try:\n        return mapping[key]\n    except KeyError:\n        return None\n"
    },
    {
      "expect": "quiet",
      "why": "contextlib.suppress, the endorsed alternative",
      "source": "tool",
