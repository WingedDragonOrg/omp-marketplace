      "text": "def read_row(line):\n    try:\n        return parse(line)\n    except:\n        pass\n"
    },
    {
      "expect": "trigger",
      "why": "except Exception with only a comment then pass",
      "source": "tool",
      "tool": "edit",
      "path": "svc/queue.py",
      "text": "    try:\n        self.ack(msg)\n    except Exception:\n        # nothing we can do here\n        pass\n"
    },
    {
      "expect": "trigger",
      "why": "tuple of OS errors swallowed",
      "source": "tool",
      "tool": "edit",
      "path": "svc/files.py",
      "text": "    try:\n        os.unlink(tmp)\n    except (OSError, IOError):\n        pass\n"
    },
    {
      "expect": "trigger",
      "why": "named binding then pass",
      "source": "tool",
      "tool": "edit",
      "path": "svc/index.py",
      "text": "    try:\n        idx = mapping[key]\n    except KeyError as k:\n        pass\n"
    },
    {
      "expect": "trigger",
      "why": "one-line handler",
      "source": "tool",
      "tool": "edit",
      "path": "svc/net.py",
      "text": "    try:\n        sock.close()\n    except Exception: pass\n"
    },
    {
      "expect": "quiet",
      "why": "handler logs and re-raises",
      "source": "tool",
      "tool": "edit",
